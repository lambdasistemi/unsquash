{:paths ["src" "test"]
 :deps {cheshire/cheshire {:mvn/version "5.13.0"}
        babashka/process {:mvn/version "0.5.22"}}
 :tasks
 {:requires ([babashka.fs :as fs])

  test {:doc "Run all tests"
        :task (exec 'clojure.test/run-tests)}

  analyze {:doc "Analyze a commit or range"
           :task (exec 'unsquash.cli/analyze)}

  propose {:doc "Propose orderings for analyzed graph"
           :task (exec 'unsquash.cli/propose)}

  apply {:doc "Apply chosen ordering"
         :task (exec 'unsquash.cli/apply-ordering)}

  consolidate {:doc "Smart-squash a commit range"
               :task (exec 'unsquash.cli/consolidate)}

  mcp {:doc "Start MCP server"
       :task (exec 'unsquash.mcp.server/start)}}}
